def win_checker(x,y,winr,who):
    w=[ [0,1,2],
        [3,4,5],
        [6,7,8],
        [0,3,6],
        [1,4,7],
        [2,5,8],
        [0,4,8],
        [2,4,6] ]
    tx = 0
    ty = 0
    for i in range(8):
        tx = 0
        ty = 0
        for j in range(3):
            if w[i][j] in x:
                tx = tx + 1
            if w[i][j] in y:
                ty = ty + 1
            if tx >= 3:
                who = "player 1"
                winr = True
                return winr, who
            if ty >= 3:
                who = "player 2"
                winr =True
                return winr, who
    return winr == False , who == "no_one"





winr = False
